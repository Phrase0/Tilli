#!/bin/sh
# 每次 commit 前重新產生架構文件（docs/architecture/index.html）並加入這次 commit。
# 畫面缺說明、說明有不存在的畫面、循序圖引用不存在的型別時擋下 commit。
# 啟用：git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 scripts/build_docs.py > /dev/null || exit 1
if ! python3 scripts/build_docs.py --check; then
    echo "請更新 docs/architecture/pages.md 或 docs/architecture/sequences/ 後再 commit"
    exit 1
fi
git add docs/architecture/index.html
